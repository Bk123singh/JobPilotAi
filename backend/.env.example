# Server Environment
NODE_ENV=development
PORT=5000

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobpilot_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_ACCESS_SECRET=jobpilot_super_secret_access_jwt_key_2026_production_ready
JWT_REFRESH_SECRET=jobpilot_super_secret_refresh_jwt_key_2026_production_ready
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=jobpilot-mock
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=mock-cloudinary-secret

# Resend Email
RESEND_API_KEY=re_mock_api_key_for_dev
RESEND_FROM_EMAIL=notifications@jobpilot.ai

# AI & Embeddings
AI_PROVIDER=openai
AI_API_KEY=mock-openai-key
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
